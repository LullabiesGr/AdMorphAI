# Shopify (set by Shopify CLI / Dev Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-real-app-host.example
SCOPES=read_products,write_app_proxy

# Supabase Postgres: pooled DATABASE_URL and direct DIRECT_URL
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@DIRECT_HOST:5432/postgres

# Meta Marketing API (Meta Developers > app settings)
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business → Configurations → Configuration ID (numeric)
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v26.0
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
