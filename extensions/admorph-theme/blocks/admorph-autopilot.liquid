{% if request.page_type == 'product' and product %}
  <div
    class="admorph-widget admorph-auto-slot"
    data-admorph-renderer-url="{{ 'admorph-render.js' | asset_url }}"
    data-product-handle="{{ product.handle | escape }}"
    data-product-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | escape }}{% endif %}"
    data-product-image-alt="{{ product.featured_image.alt | default: product.title | escape }}"
    data-admorph-placement="{{ block.settings.placement | escape }}"
    data-admorph-immersive="{{ block.settings.immersive | json }}"
    aria-live="polite"
    hidden
  >
    <template class="admorph-shopify-gallery">
      {% for image in product.images limit: 4 %}
        <span data-src="{{ image | image_url: width: 1400 | escape }}" data-alt="{{ image.alt | default: product.title | escape }}"></span>
      {% endfor %}
    </template>
  </div>
{% endif %}
{% schema %}
{
  "name": "AdMorph Auto Placement",
  "target": "body",
  "javascript": "admorph.js",
  "stylesheet": "admorph.css",
  "enabled_on": {"templates": ["product"]},
  "settings": [
    {
      "type": "checkbox",
      "id": "immersive",
      "label": "Show immersive ad-matched hero before product",
      "default": true
    },
    {
      "type": "select",
      "id": "placement",
      "label": "Place AI content",
      "options": [
        {"value": "after_title", "label": "Below product title"},
        {"value": "after_cart", "label": "Below add-to-cart"},
        {"value": "after_description", "label": "Below product description"}
      ],
      "default": "after_title"
    }
  ]
}
{% endschema %}
